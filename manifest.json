{
  "manifest_version": 3,
  "name": "LeetSync - Synchronize LeetCode solutions with GitHub",
  "short_name": "LeetSync",
  "description": "Sync your LeetCode solutions directly to your GitHub repository with a single click.",
  "version": "0.1.0",

  "icons": {
    "16": "src/assets/icons/icon16.png",
    "32": "src/assets/icons/icon32.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  },

  "permissions": [
    "storage",
    "identity",
    "tabs",
    "cookies",
    "scripting"
  ],

  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*",
    "https://leetcode.com/*"
  ],

  "action": {
    "default_popup": "index.html"
  },

  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ]
}
