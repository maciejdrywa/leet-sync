{
  "manifest_version": 3,
  "name": "Leet Sync",
  "description": "Tool to sync LeetCode solution with your GitHub account",
  "version": "1.0",

  "permissions": [
    "storage",
    "identity",
    "tabs",
    "cookies"
  ],

  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*",
    "https://leetcode.com/*"
  ],

  "action": {
    "default_popup": "index.html"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}